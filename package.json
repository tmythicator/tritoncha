{
  "name": "tritoncha",
  "version": "0.1.0",
  "description": "Live-coding music and 3D WebGL visuals studio built with ClojureScript, Tone.js and Three.js.",
  "author": "Alexandr Timchenko",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "shadow-cljs watch app",
    "watch": "shadow-cljs watch app",
    "build": "shadow-cljs release app",
    "serve": "shadow-cljs server",
    "compile": "shadow-cljs compile app",
    "test": "shadow-cljs compile test",
    "perf": "shadow-cljs compile perf && node target/perf.cjs",
    "lint": "clj-kondo --lint src test",
    "fmt": "cljfmt fix src test",
    "fmt:check": "cljfmt check src test",
    "clean": "rm -rf .shadow-cljs public/js target"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "scheduler": "^0.27.0",
    "three": "^0.164.0",
    "tone": "^14.7.77"
  },
  "devDependencies": {
    "shadow-cljs": "^2.28.9"
  }
}
